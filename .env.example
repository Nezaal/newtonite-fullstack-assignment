# Used by docker compose. Copy to .env:   cp .env.example .env
# (.env is never committed.)

POSTGRES_USER=newtonite
POSTGRES_PASSWORD=newtonite_dev_pw
POSTGRES_DB=newtonite

# Secret that signs login tokens. Use any long random value (at least 16 characters).
JWT_SECRET=change-me-to-a-long-random-string

# Optional: change a port if it is already in use on your machine.
# WEB_PORT=8080
# API_PORT=4000
# DB_PORT=5432
