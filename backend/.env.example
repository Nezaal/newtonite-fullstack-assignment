# Copy this file to .env and adjust. .env is never committed.

# Postgres connection. User, password and database must match the root .env used by docker compose.
DATABASE_URL="postgresql://newtonite:newtonite_dev_pw@localhost:5432/newtonite?schema=public"

# API
PORT=4000
# Secret used to sign login tokens. Use a long random value (at least 16 characters).
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Allowed browser origin(s), comma separated
CORS_ORIGIN=http://localhost:5173

# Optional
# RATE_LIMIT_MAX=300          # requests per minute per IP
# LOGIN_RATE_LIMIT_MAX=10     # login attempts per 15 minutes per IP
# TRUST_PROXY=0               # set to 1 when running behind nginx / a load balancer
